# PRODUCTION values — paste this whole file into Railway → vybli_backend →
# Variables → Raw Editor. This file is gitignored (.env.* is excluded), same
# as .env. It is NOT read by `npm run dev` — that still uses .env, on purpose,
# so local development keeps working without R2/Play Billing set up.
#
# ── Deploying ────────────────────────────────────────────────────────────────
# `railway.json` at the repo root pins the Dockerfile builder and points
# Railway's own rollout healthcheck at /api/v1/health (a DB round trip, not
# just "the process started") — a broken deploy is held back rather than
# taking traffic. In the service's Settings → Networking, set the target port
# to the same value as PORT below (the Dockerfile also EXPOSEs it).
#
# Migrations do NOT run automatically on deploy — the runtime image
# deliberately ships without the Prisma CLI (see the Dockerfile's own top
# comment on the three-stage split), so a Railway "Pre-Deploy Command" against
# that image cannot run `prisma migrate deploy` either. Apply them from your
# own machine instead, against Railway's Postgres, before (or right after)
# a deploy that adds one:
#   railway link                          # once, picks this project/service
#   railway run npx prisma migrate deploy
#   railway run node prisma/seed.js       # idempotent — cities, languages, VIP plans
# Never `prisma migrate dev` against this database.

NODE_ENV=production
PORT=4000

# Railway's own Postgres reference — resolves automatically inside Railway,
# only valid pasted into Railway's Variables tab (not runnable locally).
# Requires a Postgres service literally named "Postgres" in the same Railway
# project (Railway → New → Database → PostgreSQL uses that name by default);
# rename the reference to match if yours is named differently.
DATABASE_URL=${{Postgres.DATABASE_URL}}

# Generated fresh for production — deliberately different from the
# "dev-access-secret..." values in .env, so a leaked dev secret can't be used
# against production and vice versa.
JWT_SECRET=7859d44e58c756ca8a2ef4b43c0294429b9c11f4dc4f804dd09fdabd878ede3262897327b31ea883f9fc0c4a58674d2c
JWT_REFRESH_SECRET=348093bdb72d00586b6b819fbe9f2a26093025ebc7cdaf1790f1331e31f32cebc9110e2b28865c8869729e8c94d31e1d
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

OTP_EXPIRY=300
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN=30
# false in production, always — true here in .env is a dev-only convenience
# that returns the OTP in the API response. env.js refuses to boot with this
# on when NODE_ENV=production.
OTP_DEV_MODE=false

# No MSG91_* / SMS_PROVIDER here — deliberately. The shipped app signs in
# through Firebase phone auth by default (ApiConfig.useFirebaseAuth = true,
# vybli/lib/data/remote/api_config.dart), which delivers its own SMS and only
# ever calls this server's POST /auth/firebase/verify — the OTP_* settings
# above and MSG91 exist for the app's *other* build
# (--dart-define=VYBLI_USE_FIREBASE_AUTH=false), which this deployment does
# not need to serve unless you ship that build too. FIREBASE_PROJECT_ID below
# is what that verify endpoint checks tokens against; env.js's boot guard
# accepts Firebase alone as "a way to sign in" for exactly this reason.
# If you do need the OTP/SMS path: MSG91 is not DLT-registered yet (see
# GO-LIVE.md Step 5), so filling in MSG91_* here would boot fine and then fail
# every send at runtime — register the template before setting them.

# Real caller domain, not "*" (production refuses that). Update once the
# admin panel has a real domain — doesn't affect the mobile app or API
# testing tools either way, since CORS is browser-only.
CORS_ORIGIN=*

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=600

EARNER_SHARE=0.70
EARNING_CLEAR_HOURS=48
MIN_WITHDRAWAL_INR=500

# Forced off in production by env.js regardless of this value — kept explicit
# for clarity.
DEMO_SHOW_SEEDED_PROFILES=false

# ── Payments ────────────────────────────────────────────────────────────────
# Deferred: env.js warns instead of crashing at boot, but
# wallet.service.purchase refuses every recharge with "payments unavailable"
# until this is set. Rest of the app works fine without it.
#
# TODO: get PLAY_BILLING_SERVICE_ACCOUNT_EMAIL and
# PLAY_BILLING_SERVICE_ACCOUNT_PRIVATE_KEY from Play Console → Setup → API
# access, then flip PAYMENT_PROVIDER to google_play.
PAYMENT_PROVIDER=none
PLAY_BILLING_PACKAGE_NAME=com.hariharan.vybli
PLAY_BILLING_SERVICE_ACCOUNT_EMAIL=
PLAY_BILLING_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Photo storage ───────────────────────────────────────────────────────────
# TODO — the one real blocker left. env.js refuses to boot with STORAGE_DRIVER
# anything but "s3" in production (a container redeploy wipes local disk,
# silently orphaning every photo URL in Postgres). Create a Cloudflare R2
# bucket and fill these in before this file will actually boot:
#   STORAGE_ENDPOINT   https://<account-id>.r2.cloudflarestorage.com
#   STORAGE_PUBLIC_URL your bucket's public dev URL (pub-xxxx.r2.dev) or a
#                       custom domain in front of it
STORAGE_DRIVER=s3
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
STORAGE_FORCE_PATH_STYLE=true

# ── LiveKit ──────────────────────────────────────────────────────────────────
LIVEKIT_URL=wss://vybli-fsvsb8x2.livekit.cloud
LIVEKIT_API_KEY=APIdZ7CFvCQ988U
LIVEKIT_API_SECRET=CtTdxJ10232ybiRZJXL33fBT8Hb8lmp4kfuCb3W62bd
LIVEKIT_TOKEN_TTL=900
LIVEKIT_EMPTY_TIMEOUT=120

# ── Admin panel ─────────────────────────────────────────────────────────────
# Generated fresh — must differ from JWT_SECRET above, or a user token would
# pass as an admin one. env.js enforces this at boot.
ADMIN_USERNAME=vybli
ADMIN_PASSWORD_HASH=$2a$12$43yu9W8VtoOFlf/n7isXPuKh4fVbFqeB4KBqu5DwworeMQegSBX.2
ADMIN_JWT_SECRET=77c22555276f9aecc08a718f16f755b8480eae1faaf6485a086cfdd58ebc2e57c3dae7d672cb3f77e8cb028ed276e963
ADMIN_SESSION_EXPIRY=8h
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# ── Firebase phone sign-in ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=vybli-4b27f
FIREBASE_MAX_AUTH_AGE=600

GEOIP_PROVIDER=ipapi
REVERSE_GEOCODE_PROVIDER=nominatim
# Nominatim's usage policy asks requests to identify the calling application;
# the code default ("Vybli/1.0", no contact info) is the bare minimum that
# passes without erroring but is more likely to get rate-limited or blocked
# under load. Point it at a real, reachable URL once you have one.
NOMINATIM_USER_AGENT=Vybli/1.0 (+https://vybli.app)

# Copy to .env and fill in. Never commit the real .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/vybli?schema=public"

# Tokens. Use long random strings in production — `openssl rand -hex 48`.
# The two secrets MUST differ, or a refresh token would be accepted as an
# access token.
JWT_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"

# OTP
OTP_EXPIRY=300              # seconds a code stays valid
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5          # wrong guesses before the code is burned
OTP_RESEND_COOLDOWN=30      # seconds between sends to one number

# In development, with no SMS provider configured, the OTP is returned in the
# response and printed to the terminal so the app is testable without an SMS
# account. Production refuses to boot with this on.
OTP_DEV_MODE=true

# ── Firebase phone sign-in ───────────────────────────────────────────────────
# Firebase verifies the phone number; this server still owns the account, the
# session and every foreign key. Nothing here keys off a Firebase UID, so
# switching to your own SMS gateway later is a one-file change.
#
# The project id is ALL that is required. Verifying an ID token checks a
# signature against Google's public certificates and then checks the claims —
# no credential is involved. Find it in google-services.json, or in the
# Firebase console under Project settings → General.
FIREBASE_PROJECT_ID=

# How old a Firebase sign-in may be before this server stops accepting it.
# Firebase tokens live an hour, and this endpoint creates accounts.
FIREBASE_MAX_AUTH_AGE=600

# OPTIONAL. Supplying a service account additionally enables the revoked-user
# check. Only worth the key management if you also disable Firebase users
# somewhere. The private key must be on ONE line, in double quotes, with the
# 
 sequences left exactly as the JSON shows them.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── SMS delivery ─────────────────────────────────────────────────────────────
# Who actually carries the OTP. Production refuses to boot without one — an
# API where nobody can sign in is not a running API.
#
# Set these and OTP_DEV_MODE=true together to send real SMS while still
# seeing the code in your terminal during development.
SMS_PROVIDER=msg91

# MSG91 → Settings → API → Auth Key. Shown once; never commit it.
MSG91_AUTH_KEY=

# The DLT-registered template. MSG91 calls this the Flow / Template ID.
# Indian carriers reject any message whose text does not match the
# registration character for character, which is why the sentence lives on
# MSG91's side and this code only sends the id and the variables.
MSG91_TEMPLATE_ID=

# Six characters, DLT-approved, shown as the sender on the phone. Usually
# already attached to the template — leave empty if so.
MSG91_SENDER_ID=

# The variable name inside your template, as the MSG91 dashboard shows it.
# Getting this wrong delivers an empty message.
MSG91_OTP_VAR=var1

# Comma-separated. "*" allows any origin — development only.
CORS_ORIGIN=*

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120

# Economy
EARNER_SHARE=0.70           # share of what a caller spends that the earner receives — the 70% earner / 30% platform split
EARNING_CLEAR_HOURS=48      # how long earnings stay pending
MIN_WITHDRAWAL_INR=100
MESSAGE_PRICE_INR=1          # per chat message, paying accounts only (women, earners and VIPs send free); all to Vybli

# Seeded profiles (npm run seed:demo) are real rows, but nobody is behind
# them. This decides whether they may appear in a discovery feed. Forced off in
# production whatever it says here, so a real user is never offered one.
DEMO_SHOW_SEEDED_PROFILES=true

# ── Payments ────────────────────────────────────────────────────────────────
# Who takes the money for a wallet recharge. `none` means no provider is wired
# in: development credits the wallet directly so the ledger screens have
# something to show, and every such row says "no payment taken" in its
# subtitle. Production REFUSES TO BOOT with `none`, because the endpoint would
# otherwise be an authenticated way to get money for free.
PAYMENT_PROVIDER=none

# Google Play Billing — recharge and VIP purchases are Play in-app products,
# bought on-device via the Play Billing SDK. The client sends the resulting
# purchase token to this server, which verifies it server-to-server against
# the Play Developer API before crediting anything. Set
# PAYMENT_PROVIDER=google_play to use these.
#
# PLAY_BILLING_PACKAGE_NAME is the app's applicationId (see
# android/app/build.gradle), e.g. com.hariharan.vybli.
#
# The service account: Play Console → Setup → API access → create (or link) a
# Google Cloud service account, grant it "View app information and download
# bulk reports" + "Manage orders and subscriptions" under Account
# permissions, then create a JSON key for it. PLAY_BILLING_SERVICE_ACCOUNT_EMAIL
# is the key's `client_email`; PLAY_BILLING_SERVICE_ACCOUNT_PRIVATE_KEY is its
# `private_key`, on ONE line, in double quotes, with the \n sequences left
# exactly as the JSON shows them — same format as FIREBASE_PRIVATE_KEY above.
#
# Every `RechargePackage`/`VipPlan` row's id IS the Play Console product SKU —
# create one in-app product per catalogue row (Play Console → Monetize →
# Products → In-app products), id for id, priced to match `priceInr`.
PLAY_BILLING_PACKAGE_NAME=
PLAY_BILLING_SERVICE_ACCOUNT_EMAIL=
PLAY_BILLING_SERVICE_ACCOUNT_PRIVATE_KEY=

# ── Firebase SMS usage & cost (admin dashboard) ─────────────────────────────
# The app has Firebase send the OTP SMS straight from the phone, so this
# server cannot count sends itself. The admin "SMS usage" page reads Google's
# own figures instead, in the background every SMS_SYNC_INTERVAL_MINUTES:
#
#   * usage  — Cloud Monitoring, identitytoolkit.googleapis.com/usage/*
#              (sent / verified / blocked) + sendVerificationCode errors.
#   * charges — the Cloud Billing export in BigQuery. The Cloud Billing API
#              does not report costs; the export is the only source.
#
# Credentials default to FIREBASE_CLIENT_EMAIL / FIREBASE_PRIVATE_KEY above.
# In Google Cloud IAM, grant that service account:
#   roles/monitoring.viewer       on the Firebase project      (usage)
#   roles/bigquery.jobUser        on the export's project       (charges)
#   roles/bigquery.dataViewer     on the billing export dataset (charges)
# Override with a separate read-only account if you prefer:
# GCP_MONITORING_CLIENT_EMAIL=
# GCP_MONITORING_PRIVATE_KEY=
# SMS_MONITORING_PROJECT_ID=        # defaults to FIREBASE_PROJECT_ID
SMS_MONITORING_ENABLED=true

# Billing → Billing export → BigQuery export → "Standard usage cost". Leave
# empty and the dashboard shows actual charges as unavailable (never as ₹0).
GCP_BILLING_EXPORT_TABLE=           # project.dataset.gcp_billing_export_v1_XXXXXX_XXXXXX_XXXXXX
GCP_BILLING_LOCATION=               # dataset location, e.g. US, EU, asia-south1
# GCP_BILLING_QUERY_PROJECT=        # where the query job runs; defaults to the table's project

# Estimate pricing — https://cloud.google.com/identity-platform/pricing
# (checked 2026-10-08: India $0.07/SMS, first 10 SMS per project per day not
# billed). The admin panel can override these without a redeploy.
SMS_RATE_USD=0.07
SMS_FREE_PER_DAY=10
SMS_USD_TO_INR=90
SMS_PRICED_REGION=IN
# Google's billing day (when the free 10 reset). Pacific unless you know otherwise.
SMS_BILLING_TIMEZONE=America/Los_Angeles
SMS_SYNC_INTERVAL_MINUTES=15

# ── LiveKit ──────────────────────────────────────────────────────────────────
# Carries the call audio and video. Everything else about a call — who may ring
# whom, the billing clock, the history row — stays on this server; LiveKit is
# only the media path.
#
# Get these from a project at https://cloud.livekit.io, or run your own:
#   docker run --rm -p 7880:7880 -e LIVEKIT_KEYS="devkey: <secret>" \
#     livekit/livekit-server --dev
#
# Production refuses to boot without all three, and refuses a ws:// URL —
# a call that rings and bills in silence is worse than no call at all.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# How long a join token stays valid. It only has to cover the walk from "the
# phone rang" to "the room is joined"; the session itself outlives it.
LIVEKIT_TOKEN_TTL=900

# Backstop for a room the server somehow failed to close. Rooms are torn down
# explicitly when a call ends, so this should never fire.
LIVEKIT_EMPTY_TIMEOUT=120

# In the LiveKit project settings, point the webhook at:
#   https://api.yourdomain.com/api/v1/livekit/webhook
# It is what ends a call when a phone dies mid-conversation, so the billing
# ticker stops instead of charging into a dead handset.

# ── Admin panel ──────────────────────────────────────────────────────────────
# One administrator, one credential. There is no admin registration, no second
# account and no role system — the platform has exactly one operator.
#
# These never reach the browser and are never written to Postgres. In
# production set ADMIN_PASSWORD_HASH rather than ADMIN_PASSWORD: a plaintext
# password in an environment variable is readable by anything that can read
# the process environment. Generate one with:
#
#   node -e "console.log(require('bcryptjs').hashSync(process.argv[1], 12))" 'your password'
#
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_PASSWORD_HASH=
# Must differ from JWT_SECRET, or a user token would pass as an admin one.
# openssl rand -hex 48
ADMIN_JWT_SECRET=
# Anything jsonwebtoken understands: 30m, 8h, 7d.
ADMIN_SESSION_EXPIRY=8h
# Wrong passwords from one address before it is locked out.
ADMIN_MAX_FAILED_LOGINS=5
ADMIN_LOCKOUT_MINUTES=15

# Locating a user by IP when their phone cannot locate itself.
#   none  = off (default). No lookup, no third party.
#   ipapi = ip-api.com. No key required; sends each user IP to a third party.
# For production prefer MaxMind GeoLite2: a local file, no external call, no
# rate limit. Swap it in at `_lookupIpApi` in src/services/geoip.service.js.
GEOIP_PROVIDER=none

# ── Avatars ──────────────────────────────────────────────────────────────────
#
# Nothing to configure. Every account picks from the predefined catalog under
# `src/assets/avatars/` — bundled with the code and served by this same
# server at `/avatars/...` in every environment, never uploaded by a client
# and never needing object storage.

# ── End-to-end encrypted chat ────────────────────────────────────────────────
# Current apps always encrypt. This decides what happens to a message from an
# app built before encryption existed: false stores it readable (as before),
# true refuses it with "please update". Turn it on once the encrypting app
# version has shipped to everyone.
E2EE_REQUIRED=false

# Encryption at rest for columns the server must read but a leaked database
# should not reveal (payout UPI IDs). base64 of 32 bytes: `openssl rand -base64 32`.
# Keep it out of backups; losing it makes those values unreadable.
DATA_ENCRYPTION_KEY=

# How many days a chat message exists before it is deleted for everyone.
# The app says "7 days" — change its `kMessageRetentionDays` in the same release.
MESSAGE_RETENTION_DAYS=7

# ── App updates ─────────────────────────────────────────────────────────────
# Google Play decides whether a newer build exists; these decide whether the
# app *forces* it. Android builds whose versionCode (the number after `+` in
# pubspec's `version`) is below this are blocked until they update. Raise it
# only after the new build is live on Play. 0 = never force.
ANDROID_MIN_SUPPORTED_BUILD=0
# Optional wording for the update prompt. Empty uses the app's own.
APP_UPDATE_MESSAGE=
